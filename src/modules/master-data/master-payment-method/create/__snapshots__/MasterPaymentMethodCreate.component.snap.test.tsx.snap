                class="flex items-center justify-between rounded-2xl border-2 border-border-strong bg-background-surface px-5 py-4 lg:col-span-2"
              >
                <div
                  class="flex flex-col"
                >
                  <div
                    class="flex items-center gap-2.5"
                  >
                    <span
                      class="text-lg font-normal text-text-primary"
                    >
                      Status
                    </span>
                    <span
                      class="inline-flex rounded-full border border-current px-3 py-0.5 text-base font-semibold uppercase bg-success-subtle text-success-strong"
                    >
                      active
                    </span>
                  </div>
                  <span
                    class="text-base text-text-secondary"
                  >
                    Toggle active or inactive status
                  </span>
                </div>
                <button
                  aria-checked="true"
                  aria-label="Payment method status"
                  class="ant-switch css-dev-only-do-not-override-eofgey css-var-root ant-switch-checked"
                  role="switch"
                  type="button"
                >
                  <div
                    class="ant-switch-handle"
                  />
                  <span
                    class="ant-switch-inner"
                  >
                    <span
                      class="ant-switch-inner-checked"
                    />
                    <span
                      class="ant-switch-inner-unchecked"
                    />
                  </span>
                </button>
              </div>
            </div>
          </div>
          <div
            class="mt-auto flex justify-between gap-3 border-t border-border-default/60 pt-5 lg:border-border-default"
          >
            <button
              class="h-14 cursor-pointer rounded-xl border border-border-default px-8 text-lg font-semibold text-text-primary transition-colors hover:bg-background-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-action-primary disabled:cursor-not-allowed disabled:opacity-50 lg:text-lg"
              type="button"
            >
              Cancel
            </button>
            <button
              class="h-14 cursor-pointer rounded-xl bg-action-primary px-8 text-lg font-semibold text-text-inverse shadow-xs transition-colors hover:bg-action-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-action-primary disabled:cursor-not-allowed disabled:opacity-60 lg:text-lg"
              type="submit"
            >
              Update Payment Method
            </button>
          </div>
        </form>
        <div
          aria-hidden="true"
          class="h-24 shrink-0 lg:hidden"
        />
      </div>
    </div>
  </div>
</DocumentFragment>
`;
