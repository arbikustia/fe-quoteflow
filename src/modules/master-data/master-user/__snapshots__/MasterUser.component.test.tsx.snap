        </div>
        <div
          class="hidden rounded-3xl border border-border-default bg-background-surface px-6 pb-6 pt-0 shadow-xs md:mt-6 md:flex md:flex-1 md:flex-col md:overflow-hidden lg:flex"
        >
          <div
            class="flex items-center justify-between gap-4 border-b border-border-default py-6"
          >
            <input
              data-testid="search-filter"
            />
          </div>
          <div
            class="flex-1 overflow-auto"
          >
            <div
              data-testid="table"
            />
          </div>
          <div
            data-testid="pagination"
          />
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
`;
