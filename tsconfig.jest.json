{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "types": ["jest", "node", "vite/client"],
    "noEmit": true,
    "jsx": "react-jsx"
  }
}
